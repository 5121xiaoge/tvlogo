# ============================================================
# 直播源工具箱 · Apache 站点配置（Nginx 写法见 docs/nginx.conf.example）
# 需要启用 mod_headers、mod_expires、mod_deflate（宝塔/主流虚拟主机默认已启用）
# ============================================================

Options -Indexes
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType image/webp .webp

<IfModule mod_headers.c>
    # 安全响应头
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    # HTTPS 站点确认稳定后再取消注释（开启后浏览器一年内强制 HTTPS）
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # 内容安全策略：先以"仅报告"模式运行，在浏览器控制台确认没有违规后，
    # 把 Content-Security-Policy-Report-Only 改为 Content-Security-Policy 即可强制生效
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.byted-static.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://s4.zstatic.net https://fonts.loli.net https://unpkg.byted-static.com; font-src 'self' data: https://cdnjs.cloudflare.com https://s4.zstatic.net https://fonts.loli.net https://*.loli.net; img-src * data: blob:; media-src * data: blob:; connect-src *; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

    # 台标允许其它站点/播放器跨域引用
    <FilesMatch "\.(png|jpe?g|webp|svg|gif)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
    # HTML 不缓存，保证更新立即生效
    <FilesMatch "\.html?$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png  "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType text/css   "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>

# 禁止访问敏感文件
<FilesMatch "(^\.|\.(log|bak|sql|ini|sh|md)$|^config\.php$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
