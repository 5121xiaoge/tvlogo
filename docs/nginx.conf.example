# 直播源工具箱 · Nginx 配置示例（放进 server { } 中）
root /www/wwwroot/your-site;
index index.html index.php;
charset utf-8;
error_page 404 /404.html;
autoindex off;

# 安全响应头
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "SAMEORIGIN" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
# 确认无违规后把 -Report-Only 去掉即可强制生效
add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.byted-static.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://s4.zstatic.net https://fonts.loli.net https://unpkg.byted-static.com; font-src 'self' data: https://cdnjs.cloudflare.com https://s4.zstatic.net https://fonts.loli.net https://*.loli.net; img-src * data: blob:; media-src * data: blob:; connect-src *; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'" always;

gzip on;
gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

# 禁止访问内部目录与敏感文件
location ~ ^/(lib|socks5/cache|docs)/ { deny all; }
location ~ /\.(?!well-known) { deny all; }
location ~* \.(log|bak|sql|ini|sh|md)$ { deny all; }

# 台标：长缓存 + 允许跨域引用
location /LOGO/ {
    add_header Access-Control-Allow-Origin "*";
    add_header Cache-Control "public, max-age=2592000";
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
}
location ~* \.(css|js)$ { add_header Cache-Control "public, max-age=604800"; }
location ~* \.html?$  { add_header Cache-Control "no-cache"; }

location ~ \.php$ {
    include fastcgi_params;
    fastcgi_pass unix:/tmp/php-cgi.sock;   # 按实际 PHP-FPM 地址修改
    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
}
